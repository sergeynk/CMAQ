! add documentation header later

CARBON

REACTIONS[CM] = 

! rate from cracmm2
!<R001> ECH4 + OH = CO + LCH4OH + PCOCH4   # 2.45E-12 @ 1775.;
! temporary rate that incorporates fixed OH of 2e6 molecules/cm3
<R001> ECH4      = CO + LCH4OH + PCOCH4  # 4.9E-06 @ 1775;
! rate from Sergey mech def (cb6 rate?) 
!<R002> ECH4 + CL = CO + LCH4CL + PCOCH4  # 6.6E-12 @ 1240;
! temporary rate that incorporates a fixed Cl of 2e4 molecules/cm3
<R002> ECH4 +    = LCH4CL + PCOCH4  # 1.32E-07 @ 1240;
! rate from cracmm2
!<R003> CO   + OH = CO2 + LCOOH + PCO2CO %3 # 1.44E-13 @ 0.0 & 2.74E-33 @ 0.0;
! temporary rate that incorporates fixed OH of 2e6 molecules/cm3
<R003> CO   +    = CO2 + LCOOH + PCO2CO %3 # 2.88E-07 @ 0.0 & 5.48E-27 @ 0.0;
! is this necessary? if so then need generic rate
! GC uses dummy NMVOC species at 1 molecule/cm3 with a rate based on P(CO) from NMVOC
!<R004> ROC  + OH = CO  #

END MECH

CONSTANTS
<C1> ATM_AIR = 1.0E+06
<C2> ATM_H2  = 0.56
<C3> ATM_N2  = 0.7808E+06
<C4> ATM_O2  = 0.2095E+06
<C5> ATM_CH4 = 1.85
END CONSTANTS

